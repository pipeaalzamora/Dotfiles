# ~/.zshrc.local — Configuración personal / por máquina
# ======================================================
# Este archivo NO se versiona en git (está en .gitignore).
# Copia esta plantilla a ~/.zshrc.local y personalízala.
# El .zshrc lo carga automáticamente al final si existe.

# ------------------------------------------------------------
# PATHs específicos de tu máquina
# ------------------------------------------------------------
# Flutter
# export PATH="$HOME/develop/flutter/bin:$PATH"

# spicetify
# export PATH="$PATH:$HOME/.spicetify"

# ------------------------------------------------------------
# spotDL — Descargador de Spotify
# Requiere: pipx install spotdl  (o pip install spotdl)
# El cookie-file es opcional y contiene datos sensibles:
# NO lo subas a git. Ajusta la ruta o elimina la línea --cookie-file.
# ------------------------------------------------------------
spd() {
    if [ -z "$1" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        echo "🎵 SpotDL - Descargador de Spotify"
        echo ""
        echo "Uso:  spd <url>                    → MP3 en ~/Música/Spotify"
        echo "      spd <url> <formato>           → mp3 | flac | opus | ogg | m4a | wav"
        echo "      spd <url> <formato> <carpeta> → Carpeta personalizada"
        echo ""
        echo "Ejemplos:"
        echo "  spd 'https://open.spotify.com/playlist/...'"
        echo "  spd 'https://open.spotify.com/album/...' flac"
        echo "  spd 'https://open.spotify.com/playlist/...' mp3 ~/Música/Chill"
        return 0
    fi

    local url="$1"
    local format="${2:-mp3}"
    local output_dir="${3:-$HOME/Música/Spotify}"
    mkdir -p "$output_dir"

    echo ""
    echo "🎵 SpotDL iniciando..."
    echo "🔗 URL:     $url"
    echo "📁 Destino: $output_dir"
    echo "🎧 Formato: $format"
    echo ""

    local -a spd_args=(
        --audio youtube
        --threads 4
        --no-cache
        --format "$format"
        --output "$output_dir/{artists} - {title}"
    )
    # Descomenta y ajusta si usas cookies (archivo con datos sensibles):
    # [ -f "$HOME/cookies.txt" ] && spd_args+=(--cookie-file "$HOME/cookies.txt")

    spotdl "${spd_args[@]}" "$url"
    local exit_code=$?

    if [ $exit_code -eq 0 ]; then
        echo ""
        echo "✅ ¡Descarga completada en $output_dir!"
        command -v notify-send &>/dev/null && \
            notify-send "🎵 SpotDL" "✅ Descarga completada\n📁 $output_dir" \
                --icon=audio-x-generic --urgency=normal --expire-time=5000
    else
        echo ""
        echo "⚠️  Descarga finalizada con algunos errores."
        command -v notify-send &>/dev/null && \
            notify-send "🎵 SpotDL" "⚠️ Descarga con errores\n📁 $output_dir" \
                --icon=dialog-warning --urgency=normal --expire-time=5000
    fi

    return $exit_code
}

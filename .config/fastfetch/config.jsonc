{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " 󰅂 "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󰔚 Uptime",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "󰘚 RAM",
      "keyColor": "magenta"
    },
    "break",
    "colors"
  ]
}

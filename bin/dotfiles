#!/usr/bin/env bash
# ==============================================================================
# Pipe's Dotfiles - Unified CLI Manager
# ==============================================================================
set -euo pipefail

# Sanitizar locale si el configurado genera advertencias
if [[ -n "${LC_ALL:-}" ]] && ! locale -a 2>/dev/null | tr -d '._-' | grep -qi "$(echo "${LC_ALL}" | tr -d '._-')"; then
    export LC_ALL="C.UTF-8"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/utils.sh
source "${SCRIPT_DIR}/scripts/lib/utils.sh"

show_help() {
    cat <<EOF
${COLOR_BOLD}Uso:${COLOR_RESET} dotfiles <comando> [opciones]

${COLOR_BOLD}Comandos principales:${COLOR_RESET}
  ${COLOR_GREEN}install${COLOR_RESET}        Ejecuta la instalación y aprovisionamiento completo
  ${COLOR_GREEN}update${COLOR_RESET}         Actualiza paquetes del sistema, gestores y repos
  ${COLOR_GREEN}doctor${COLOR_RESET}         Verifica la salud de dependencias y enlaces

${COLOR_BOLD}Gestión de interfaz:${COLOR_RESET}
  ${COLOR_GREEN}theme${COLOR_RESET}          Gestiona temas (claro/oscuro) y aplicaciones
  ${COLOR_GREEN}wallpaper${COLOR_RESET}      Cambia fondo de pantalla aleatorio
  ${COLOR_GREEN}monitors${COLOR_RESET}       Gestor de monitores (perfiles de pantalla)

${COLOR_BOLD}Configuración del sistema:${COLOR_RESET}
  ${COLOR_GREEN}desktop${COLOR_RESET}        Configura KDE Plasma 6 con Catppuccin
  ${COLOR_GREEN}system${COLOR_RESET}         Configura hardware (GPU AMD, Btrfs snapshots)
  ${COLOR_GREEN}profiles${COLOR_RESET}       Gestiona perfiles de KDE (guardar/restaurar)

${COLOR_BOLD}Instaladores:${COLOR_RESET}
  ${COLOR_GREEN}programs${COLOR_RESET}       Instalador interactivo de programas
  ${COLOR_GREEN}themes${COLOR_RESET}         Instalador interactivo de temas y cursores
  ${COLOR_GREEN}git${COLOR_RESET}            Configura Git globalmente

${COLOR_BOLD}Utilidades:${COLOR_RESET}
  ${COLOR_GREEN}verse${COLOR_RESET}          Muestra versículos aleatorios de la Biblia
  ${COLOR_GREEN}help${COLOR_RESET}           Muestra este mensaje de ayuda

EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    install)
        log_step "Iniciando instalación de Dotfiles"
        if [[ -f "${SCRIPT_DIR}/install.sh" ]]; then
            "${SCRIPT_DIR}/install.sh" "$@"
        else
            log_error "No se encontró el instalador principal en ${SCRIPT_DIR}/install.sh"
            exit 1
        fi
        ;;
    theme)
        if [[ -f "${SCRIPT_DIR}/scripts/theme.sh" ]]; then
            "${SCRIPT_DIR}/scripts/theme.sh" "$@"
        elif [[ -f "${SCRIPT_DIR}/scripts/theme-switcher.sh" ]]; then
            "${SCRIPT_DIR}/scripts/theme-switcher.sh" "$@"
        else
            log_error "Módulo de temas no encontrado."
            exit 1
        fi
        ;;
    wallpaper)
        if [[ -f "${SCRIPT_DIR}/scripts/change-wallpaper.sh" ]]; then
            "${SCRIPT_DIR}/scripts/change-wallpaper.sh" "$@"
        else
            log_error "Módulo de fondos no encontrado."
            exit 1
        fi
        ;;
    monitors)
        if [[ -f "${SCRIPT_DIR}/scripts/manage-monitors.sh" ]]; then
            "${SCRIPT_DIR}/scripts/manage-monitors.sh" "$@"
        else
            log_error "Módulo de monitores no encontrado."
            exit 1
        fi
        ;;
    desktop)
        if [[ -f "${SCRIPT_DIR}/scripts/setup-kde.sh" ]]; then
            "${SCRIPT_DIR}/scripts/setup-kde.sh" "$@"
        else
            log_error "Módulo de escritorio KDE no encontrado."
            exit 1
        fi
        ;;
    profiles)
        if [[ -f "${SCRIPT_DIR}/scripts/manage-kde-profile.sh" ]]; then
            "${SCRIPT_DIR}/scripts/manage-kde-profile.sh" "$@"
        else
            log_error "Módulo de perfiles no encontrado."
            exit 1
        fi
        ;;
    programs)
        if [[ -f "${SCRIPT_DIR}/scripts/install-programs.sh" ]]; then
            "${SCRIPT_DIR}/scripts/install-programs.sh" "$@"
        else
            log_error "Módulo de instalación de programas no encontrado."
            exit 1
        fi
        ;;
    themes)
        if [[ -f "${SCRIPT_DIR}/scripts/install-themes.sh" ]]; then
            "${SCRIPT_DIR}/scripts/install-themes.sh" "$@"
        else
            log_error "Módulo de instalación de temas no encontrado."
            exit 1
        fi
        ;;
    git)
        if [[ -f "${SCRIPT_DIR}/configure-git.sh" ]]; then
            "${SCRIPT_DIR}/configure-git.sh" "$@"
        else
            log_error "Módulo de configuración de Git no encontrado."
            exit 1
        fi
        ;;
    verse)
        if [[ -f "${SCRIPT_DIR}/scripts/daily-verse.sh" ]]; then
            "${SCRIPT_DIR}/scripts/daily-verse.sh" "$@"
        else
            log_error "Módulo de versículos no encontrado."
            exit 1
        fi
        ;;
    system)
        log_step "Verificación de hardware y sistema"
        if has_cmd lspci && lspci | grep -qi "AMD"; then
            log_info "GPU AMD detectada."
            [[ -f "${SCRIPT_DIR}/scripts/setup-amd-gpu.sh" ]] && "${SCRIPT_DIR}/scripts/setup-amd-gpu.sh" "$@"
        fi
        if has_cmd findmnt && findmnt -no FSTYPE / | grep -qi "btrfs"; then
            log_info "Sistema de archivos Btrfs detectado."
            [[ -f "${SCRIPT_DIR}/scripts/setup-btrfs-snapshots.sh" ]] && "${SCRIPT_DIR}/scripts/setup-btrfs-snapshots.sh" "$@"
        fi
        ;;
    update)
        if [[ -f "${SCRIPT_DIR}/scripts/update.sh" ]]; then
            "${SCRIPT_DIR}/scripts/update.sh" "$@"
        elif [[ -f "${SCRIPT_DIR}/scripts/update-all" ]]; then
            "${SCRIPT_DIR}/scripts/update-all" "$@"
        else
            log_error "Módulo de actualización no encontrado."
            exit 1
        fi
        ;;
    doctor)
        log_step "Diagnóstico del entorno (Dotfiles Doctor)"
        deps=("git:git" "zsh:zsh" "curl:curl" "rg:ripgrep" "tmux:tmux" "bat:bat" "fzf:fzf" "zoxide:zoxide" "lazygit:lazygit")
        missing=0
        for item in "${deps[@]}"; do
            binary="${item%%:*}"
            label="${item##*:}"
            if has_cmd "$binary"; then
                log_info "$label ($binary): instalado ($(command -v "$binary"))"
            else
                log_warn "$label ($binary): NO instalado"
                ((missing++))
            fi
        done
        if [[ $missing -eq 0 ]]; then
            log_info "Todas las dependencias esenciales están presentes."
        else
            log_warn "Hay $missing dependencias pendientes. Ejecuta 'dotfiles install' para resolverlas."
        fi
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        log_error "Comando desconocido: '$cmd'"
        show_help
        exit 1
        ;;
esac

#!/usr/bin/env bash
# ============================================================
# Actualizador Centralizado de Sistema y Herramientas (Ubuntu)
# Repositorio: pipeaalzamora/Dotfiles
# ============================================================

set -e

echo "🚀 Actualizando sistema Ubuntu y herramientas..."

# 1. Actualizar paquetes del sistema (APT)
if command -v apt &>/dev/null; then
    echo "📦 [1/8] Actualizando paquetes APT..."
    sudo apt update && sudo apt upgrade -y
fi

# 2. Limpieza de paquetes obsoletos
if command -v apt &>/dev/null; then
    echo "🧹 [2/8] Limpiando paquetes obsoletos y caché (APT)..."
    sudo apt autoremove -y 2>/dev/null || true
    sudo apt autoclean 2>/dev/null || true
fi

# 3. Snap (Ubuntu)
if command -v snap &>/dev/null; then
    echo "📦 [3/8] Actualizando paquetes Snap..."
    sudo snap refresh 2>/dev/null || true
fi

# 4. Flatpak (si está instalado)
if command -v flatpak &>/dev/null; then
    echo "📦 [4/8] Actualizando paquetes Flatpak..."
    flatpak update -y 2>/dev/null || true
fi

# 5. Node.js / NPM / PNPM
if command -v npm &>/dev/null; then
    echo "📦 [5/8] Actualizando paquetes globales de npm..."
    npm update -g 2>/dev/null || true
fi

# 6. Rust / Rustup
if command -v rustup &>/dev/null; then
    echo "📦 [6/8] Actualizando toolchain de Rust..."
    rustup update 2>/dev/null || true
fi

# 7. Python / Pipx / uv (AI & Data)
if command -v pipx &>/dev/null; then
    echo "📦 [7/8] Actualizando herramientas pipx..."
    pipx upgrade-all 2>/dev/null || true
fi
if command -v uv &>/dev/null; then
    uv self update 2>/dev/null || true
fi

# 8. Oh My Zsh y plugins
if [ -d "$HOME/.oh-my-zsh" ]; then
    echo "📦 [8/8] Actualizando Oh My Zsh y plugins..."
    git -C "$HOME/.oh-my-zsh" pull --quiet 2>/dev/null || true
    
    ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
    [ -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ] && git -C "$ZSH_CUSTOM/plugins/zsh-autosuggestions" pull --quiet 2>/dev/null || true
    [ -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ] && git -C "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" pull --quiet 2>/dev/null || true
fi

# Herramientas adicionales
if command -v spicetify &>/dev/null; then
    echo "📦 Actualizando Spicetify..."
    spicetify upgrade 2>/dev/null || true
fi

echo ""
echo "✅ ¡Sistema Ubuntu y herramientas actualizados con éxito!"

# Actualizar timestamp para el recordatorio del .zshrc
mkdir -p "$HOME/.cache"
touch "$HOME/.cache/last_update"

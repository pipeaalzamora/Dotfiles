#!/usr/bin/env bash
# ============================================================
# Verificador de dependencias y herramientas instaladas
# Repositorio: pipeaalzamora/Dotfiles
# ============================================================

echo "🔍 Verificando dependencias..."
echo ""

check_command() {
    local cmd="$1"
    local display="${2:-$1}"
    if command -v "$cmd" &>/dev/null; then
        local version=$("$cmd" --version 2>/dev/null | head -1 || echo "")
        echo -e "✅ $display \033[0;90m$version\033[0m"
    else
        echo "❌ $display — NO INSTALADO"
    fi
}

echo "=== Shell & Prompt ==="
check_command zsh
check_command starship

echo ""
echo "=== Terminal & Multiplexores ==="
check_command kitty
check_command zellij

echo ""
echo "=== Editores ==="
check_command nvim "neovim"

echo ""
echo "=== Herramientas CLI ==="
check_command lsd
if command -v bat &>/dev/null; then check_command bat; else check_command batcat "bat"; fi
if command -v fd &>/dev/null; then check_command fd; else check_command fdfind "fd"; fi
check_command rg "ripgrep"
check_command fzf
check_command zoxide
check_command yazi
check_command lazygit
check_command delta "git-delta"
check_command vivid
check_command fx
check_command dust
check_command procs
check_command tldr "tealdeer"
check_command btop
check_command fastfetch

echo ""
echo "=== KDE Plasma & Entorno Gráfico ==="
check_command kvantummanager "Kvantum"
check_command rofi "Rofi-Wayland"
check_command spicetify "Spicetify CLI"
check_command konsave "Konsave"
check_command easyeffects "EasyEffects"
check_command snapper "Snapper (Btrfs)"

echo ""
echo "=== Desarrollo ==="
check_command git
check_command node
check_command npm
check_command bun
check_command go
check_command rustc "rust"
check_command cargo
check_command python3 "python"
check_command pipx

echo ""
echo "=== Utilidades ==="
check_command curl
check_command wget
check_command jq
check_command tree
check_command newsboat
check_command yt-dlp
check_command zathura
check_command wl-copy "wl-clipboard"

echo ""
echo "✅ Verificación completada"

#!/usr/bin/env bash
# ============================================================
# Verificador de dependencias y herramientas instaladas (Ubuntu)
# Repositorio: pipeaalzamora/Dotfiles
# Perfil: Fullstack + AI Engineer + DevOps
# ============================================================

echo "🔍 Verificando dependencias en Ubuntu..."
echo ""

check_command() {
    local cmd="$1"
    local display="${2:-$1}"
    if command -v "$cmd" &>/dev/null; then
        local version
        version=$("$cmd" --version 2>/dev/null | head -1 || echo "")
        echo -e "✅ $display \033[0;90m$version\033[0m"
    else
        echo -e "❌ $display — \033[0;31mNO INSTALADO\033[0m"
    fi
}

echo "=== Shell, Terminal & Editores ==="
check_command zsh
check_command starship
check_command kitty
check_command zellij
check_command nvim "neovim"

echo ""
echo "=== Herramientas CLI & Navegación ==="
check_command lsd
if command -v bat &>/dev/null; then check_command bat; else check_command batcat "bat"; fi
if command -v fd &>/dev/null; then check_command fd; else check_command fdfind "fd"; fi
check_command rg "ripgrep"
check_command fzf
check_command zoxide
check_command yazi
check_command lazygit
if command -v delta &>/dev/null; then check_command delta "git-delta"; else check_command git-delta "git-delta"; fi
if command -v tldr &>/dev/null; then check_command tldr "tldr"; else check_command tealdeer "tealdeer"; fi
check_command btop
check_command fastfetch
check_command jq
check_command tree

echo ""
echo "=== Fullstack Development ==="
check_command git
check_command node
check_command npm
check_command pnpm
check_command bun
check_command go
check_command rustc "rust"
check_command cargo
check_command psql "postgresql-client"
check_command redis-cli "redis-tools"
check_command sqlite3
check_command http "httpie"

echo ""
echo "=== AI Engineering ==="
check_command python3 "python"
check_command pipx
check_command uv "uv (Astral)"
check_command ollama "Ollama (Local LLMs)"

echo ""
echo "=== DevOps & Cloud ==="
check_command docker
if docker compose version &>/dev/null; then
    echo -e "✅ docker compose \033[0;90m$(docker compose version 2>/dev/null | head -1)\033[0m"
elif command -v docker-compose &>/dev/null; then
    check_command docker-compose
else
    echo -e "❌ docker compose — \033[0;31mNO INSTALADO\033[0m"
fi
check_command lazydocker
check_command kubectl
check_command k9s
check_command helm
check_command kubectx
check_command kubens

echo ""
echo "=== Multimedia & Sistema ==="
check_command easyeffects "EasyEffects"
check_command cava
check_command yt-dlp
check_command zathura
check_command wl-copy "wl-clipboard"

echo ""
echo "✅ Verificación completada"
